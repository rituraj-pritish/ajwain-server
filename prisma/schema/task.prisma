model Task {
  id    Int   @id   @default(autoincrement())
  title   String    
  description   String?
  createdAt   DateTime    @default(now())
  createdByUserId   Int
  date    DateTime?
  memberIds   String?
  status    TaskStatus    @default(PENDING)
  boardId   Int?
  board   Board?   @relation(fields: [boardId], references: [id])
}